      <aliases enabled='yes' />
      <column caption='Acquisition Channel' datatype='string' name='[Acquisition_Channel]' role='dimension' type='nominal' />
      <column caption='Cohort Month' datatype='datetime' name='[Calculation_0231198399389696]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='{ FIXED [Customer_ID] : MIN(DATETRUNC(&apos;month&apos;, [Transaction_Date])) }' />
      </column>
      <column aggregation='Sum' caption='Tenure Month' datatype='integer' name='[Calculation_0231198399492097]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATEDIFF(&apos;month&apos;, [Calculation_0231198399389696], DATETRUNC(&apos;month&apos;, [Transaction_Date]))' />
      </column>
      <column caption='Cohort Size' datatype='integer' name='[Calculation_0231198399614978]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED [Calculation_0231198399389696] : COUNTD([Customer_ID]) }' />
      </column>
      <column caption='Active Customers' datatype='integer' name='[Calculation_0231198399700995]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([Customer_ID])' />
      </column>
      <column caption='Retention %' datatype='real' name='[Calculation_0231198399782916]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNTD([Customer_ID]) / LOOKUP(COUNTD([Customer_ID]), FIRST())'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='StartOfMonth' datatype='datetime' name='[Calculation_0231198415609862]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='DATETRUNC(&apos;month&apos;, [Transaction_Date])' />
      </column>
      <column caption='Cumulative LTV' datatype='real' name='[Calculation_0231198418636807]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='RUNNING_SUM(SUM([Revenue])) / SUM({ FIXED [Calculation_0231198423154696] : COUNTD([Customer_ID]) })'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column aggregation='Sum' caption='Cohort Year' datatype='integer' name='[Calculation_0231198423154696]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='YEAR([Calculation_0231198399389696])' />
      </column>
      <column caption='Average CAC per Customer' datatype='real' name='[Calculation_0231198423269385]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED : SUM({ FIXED [Customer_ID] : AVG([CAC]) }) / COUNTD([Customer_ID]) }' />
      </column>
      <column caption='Total/Avg CAC for reference line' datatype='real' name='[Calculation_0231198423420938]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED : AVG([Calculation_0231198423269385])}' />
      </column>
